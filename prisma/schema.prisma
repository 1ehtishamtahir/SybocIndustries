generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum MenuArea {
  HEADER
  FOOTER
}

enum CategoryType {
  PRODUCT
  BLOG
}

enum SubmissionType {
  QUOTE
  CONTACT
}

model AdminUser {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         Role         @default(EDITOR)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  pages        Page[]
  posts        BlogPost[]
  media        Media[]
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  content        String        @db.LongText
  excerpt        String?       @db.Text
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?       @db.Text
  keywords       String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String?
  author         AdminUser?    @relation(fields: [authorId], references: [id])

  @@index([status])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  note           String?
  price          Decimal?      @db.Decimal(10, 2)
  priceNote      String?
  description    String?       @db.Text
  content        String?       @db.LongText
  details        Json?
  colors         Json?
  image          String?
  gallery        Json?
  status         PublishStatus @default(DRAFT)
  order          Int           @default(0)
  seoTitle       String?
  seoDescription String?       @db.Text
  keywords       String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])

  @@index([status, order])
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  type        CategoryType
  description String?       @db.Text
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
  posts       BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?       @db.Text
  content        String        @db.LongText
  coverImage     String?
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?       @db.Text
  keywords       String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String?
  author         AdminUser?    @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  tags           Tag[]

  @@index([status, publishedAt])
}

model Tag {
  id    String      @id @default(cuid())
  name  String
  slug  String      @unique
  posts BlogPost[]
}

model Media {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  alt          String?
  width        Int?
  height       Int?
  createdAt    DateTime   @default(now())
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id])
}

model NavigationItem {
  id      String    @id @default(cuid())
  label   String
  href    String
  menu    MenuArea
  isCta   Boolean   @default(false)
  order   Int       @default(0)
  visible Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([menu, order])
}

model Setting {
  key         String   @id
  value       String?  @db.LongText
  group       String   @default("general")
  label       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String         @id @default(cuid())
  type      SubmissionType
  name      String
  email     String
  phone     String?
  message   String         @db.Text
  read      Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([type, read])
}
