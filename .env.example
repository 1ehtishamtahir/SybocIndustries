# MySQL connection used by Prisma. Local dev: project-local MySQL on 3307
# (npm run db:up). Production: your cPanel database, usually localhost:3306.
DATABASE_URL=mysql://root@127.0.0.1:3307/firstmoto

# Long random string; admin sessions are HMAC-signed with it.
SESSION_SECRET=change-me-to-a-long-random-string

# Canonical site URL used for sitemap, robots, canonical and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# WhatsApp number in international format, digits only (e.g. 15551234567).
# Leave unset to hide the WhatsApp buttons.
#NEXT_PUBLIC_WHATSAPP=

# Plausible analytics domain (e.g. firstmoto.com). Leave unset to disable.
#NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Quote/inquiry delivery via Resend (https://resend.com).
# Without RESEND_API_KEY the API only logs requests to the server console.
#RESEND_API_KEY=
#RESEND_FROM=First Moto <hello@yourdomain.com>
#EMAIL_TO=hello@yourdomain.com
